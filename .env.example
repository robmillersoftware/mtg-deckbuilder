# Application
APP_NAME=Spellbook
APP_URL=http://localhost:3000
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://spellbook:spellbook@localhost:5432/spellbook
DATABASE_URL_SYNC=postgresql://spellbook:spellbook@localhost:5432/spellbook

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM via OpenRouter (any OpenRouter model id)
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=deepseek/deepseek-v4-flash

# OpenAI (for embeddings - optional)
OPENAI_API_KEY=your-openai-api-key

# TypeSafe (Jev, deck fit)
TYPESAFE_API_KEY=your-typesafe-api-key

# SendGrid (email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@spellbook.app

# Scheduler
ENABLE_SCHEDULER=true

# Admin
ADMIN_EMAIL=admin@spellbook.app
