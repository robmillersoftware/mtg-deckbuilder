# Database
DATABASE_URL=postgresql+asyncpg://spellbook:spellbook@localhost:5432/spellbook
DATABASE_URL_SYNC=postgresql://spellbook:spellbook@localhost:5432/spellbook

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (for embeddings)
OPENAI_API_KEY=your-openai-api-key

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@spellbook.app

# App settings
APP_NAME=Spellbook
APP_URL=http://localhost:3000
DEBUG=true

# Scryfall
SCRYFALL_BULK_DATA_URL=https://api.scryfall.com/bulk-data

# Admin
ADMIN_EMAIL=admin@spellbook.app
