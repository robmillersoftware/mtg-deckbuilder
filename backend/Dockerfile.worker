# RQ Worker Dockerfile
# Deploy this as a separate service in Railway alongside the main backend
FROM python:3.11-slim

WORKDIR /app

# Ensure unbuffered output for logs
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --progress-bar on -r requirements.txt

# Copy application code
COPY . .

# Run the RQ worker
CMD ["python", "rq_worker.py", "--verbose"]
